# Local template only. Copy to .env and fill from the account consoles.
# Never commit .env. Never put a signing private key in this file.
# Paper and read-only mode is the default. No live orders.

# Render (server deploy). Dashboard: https://dashboard.render.com
RENDER_API_KEY=

# Vercel (frontend host, integration phase). https://vercel.com/account/tokens
VERCEL_TOKEN=

# GitHub (repo automation only; rotate if this token was ever pasted into a chat)
GITHUB_TOKEN=

# Supabase Postgres — transaction pooler for application traffic (port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase Postgres — session pooler for migrations (port 5432)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Decision-model provider (server only; never expose to the browser)
LLM_API_KEY=
LLM_BASE_URL=https://example.invalid/v1
LLM_MODEL=

# Names the existing research code actually reads. The production loader
# copies LLM_* into these only when the T2_LLM_* values are empty.
T2_LLM_API_KEY=
T2_LLM_BASE_URL=
T2_LLM_MODEL=

# SEC fair-access contact string. Required before any live EDGAR call. Not a secret.
T2_SEC_USER_AGENT=

# Filesystem path to the Ed25519 private key. Never put key bytes here.
T2_SIGNING_KEY=

# Three distinct bearers. Generate locally. Never a browser public var.
# Reader: Vercel server proxy only. Decision and job: Render only.
AFTERMATH_API_TOKEN=
AFTERMATH_DECISION_TOKEN=
AFTERMATH_JOB_TOKEN=

# Optional. Leave empty until a phase proves the code reads them.
# BITGET_API_KEY=
# BITGET_API_SECRET=
# BITGET_API_PASSPHRASE=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# SIGNING_KEY_PATH=
